# Google Gemini API Key for AI Deep Audit & Advisory
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback Gemini Model Priority (comma-separated)
GEMINI_MODEL=gemini-2.5-flash,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.1-flash-lite

# Vercel KV / Upstash Redis for Persistent Storage on Vercel
# Automatically provided when creating a KV Database in Vercel Storage tab
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your_kv_rest_token_here

# Optional: Voiceover & Image AI Keys
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
